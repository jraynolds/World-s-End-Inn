[node name="ConversationLeaf3" parent="Old Man/Conversation follow up/start" instance=ExtResource("57_3w4ku")]
speaker = ExtResource("72_e3s4h")
speeches = Array[String](["Forgive me... you look so much like your father.", "I knew him almost a decade. He was something special. He saw the best in people. The best in me.", "I'm afraid if you came to find him, you're too late. I buried him myself, five years past... he didn't last long after the attack."])

